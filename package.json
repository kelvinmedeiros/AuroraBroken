{
  "name": "aurora-broken",
  "version": "1.0.0",
  "description": "AuroraBroken - A multiplayer game",
  "scripts": {
    "start": "node api/server.js",
    "dev": "node --watch api/server.js",
    "build:pages": "node scripts/build-pages.mjs",
    "preview:pages": "npm run build:pages && node scripts/preview-pages.mjs",
    "test": "node --test tests/*.test.mjs",
    "install-all": "npm install && cd api && npm install && cd ../client && npm install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "esbuild": "^0.28.2"
  }
}
